# Copy next to burstlimit.exe as burstlimit.toml.
# Most settings can also be changed in game: F1, or Back + Start on the controller.
log_level = "info"
# Log file next to the game (relative to the working folder). Send it if something goes wrong.
log_file = "burstlimit.log"
fullscreen = false
vsync = true
gpu_plugin = "xenos"
gpu_allow_invalid_fetch_constants = true

# Resolution scale (1 = native 720p, 2 = 1440p, 3 = 4K).
draw_resolution_scale_x = 2
draw_resolution_scale_y = 2
# Slow GPU: with the scale at 1, render below 720p (percent of 1280x720: 75 = 960x540, 50 = 640x360).
# draw_resolution_percent = 50
# Weak PC / laptop: "low_end" (960x540) or "lowest" (640x360) sets resolution, upscalers, filters
# and blur effects at once (Graphics preset in DISPLAY). "custom" = the separate settings.
# graphics_preset = "low_end"
# Renderer: true = Native (the default, faster), false = Emulated (the classic path; use it if
# something looks wrong). Applies after a restart.
# gpu_native_renderer = false
# Resolution by height: 720, 1080, 1440, 2160 (4K), 2880 (5K), 3240 (6K), 4320 (8K).
# draw_resolution_height = 1440
# Render path: empty = the fast one (all GPUs). "rov" = Compatibility, only if the picture looks
# broken (e.g. old Intel drivers); much slower. Applies after a restart.
# render_target_path_d3d12 = "rov"
# GPU: -1 = the most powerful one automatically; 0, 1, ... = the "DXGI adapter N" lines in the log.
# d3d12_adapter = -1

# Frame rate cap: "30" (the original), "60", "120", "144", "display" (your monitor's refresh
# rate) or "unlocked". Smoothest: your monitor's refresh rate or half of it (60 on a 120 Hz monitor).
frame_rate = "60"
# VSync: one whole frame per monitor refresh, locked to the monitor (even motion, no tearing;
# G-Sync / FreeSync still work). false = show frames at once (tearing).
present_vsync = true

# Online play without a VPN (see README "Online play"): rooms show up in
# Versus > Xbox LIVE Battle > Player Match. Empty online_lobby_url = LAN / Radmin VPN only
# (scripts\Host_Online.bat / Join_Online.bat).
online_lobby_url = "wss://burstlimit-lobby.azoxrag2.workers.dev/v1/ws"
# Your name in online rooms (max 15 characters, printable ASCII). Empty = your Windows user name.
online_name = ""
# Lobby matches: input delay in frames, 2 = very low ping, 3-4 = normal, 6-8 = high ping.
# The host's value is used by both players. "off" = the game's own timing (online_tick_sleep).
online_input_delay = "4"

# Game patches (see README).
# Offline fights: "reduced" = no input delay, "original" = the game's own 3 frames (50 ms).
input_delay = "reduced"
online_fast_tick = true
# LAN / Radmin VPN input buffer (both players the same): 0 = LAN, 1 = internet, 2 = high ping, 3 = original.
online_tick_sleep = 1
online_input_delay_test = true
